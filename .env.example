# Gemini API key for the portfolio chat assistant.
#
# Deliberately NOT prefixed with VITE_ — that prefix is what makes Vite inline a
# variable into the browser bundle. This key is read only by api/chat.ts, which
# runs on the server, so it never reaches the client.
#
# Set the same variable in Vercel -> Settings -> Environment Variables.
GEMINI_API_KEY=your-key-here
